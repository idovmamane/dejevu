# One key is enough. Any OpenAI-compatible chat endpoint works; OpenRouter is the default.
OPENROUTER_API_KEY=
# Optional: another OpenAI-compatible endpoint (Groq, Cerebras, a local vLLM/Ollama server...).
# INSTINCT_BASE_URL=https://openrouter.ai/api/v1
# INSTINCT_API_KEY=

# Preset: cheap (gemma-4-26b @ NextBit, logprob probabilities), fast (llama-3.3-70b @ Groq), gemini (2.5 flash lite).
# INSTINCT_PRESET=cheap
# Or pick the model yourself. INSTINCT_PROVIDER pins an OpenRouter provider (fallbacks stay allowed).
# INSTINCT_MODEL=google/gemma-4-26b-a4b-it
# INSTINCT_PROVIDER=NextBit
# INSTINCT_LOGPROBS=1

# Optional: use TypeSafe Jev as the chooser (the original jev-ultrafast design) plus a text helper for TYPE.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Browser. Leave unset to launch a private headless Chrome. Point at a running Chrome to reuse its logins.
# INSTINCT_CDP_URL=http://127.0.0.1:9222
# INSTINCT_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
