# One key is enough. Any OpenAI-compatible chat endpoint works; OpenRouter is the default.
OPENROUTER_API_KEY=
# Optional: another OpenAI-compatible endpoint (Groq, Cerebras, a local vLLM/Ollama server...).
# DEJEVU_BASE_URL=https://openrouter.ai/api/v1
# DEJEVU_API_KEY=

# Preset: cheap (gemma-4-26b @ NextBit, logprob probabilities), fast (llama-3.3-70b @ Groq), gemini (2.5 flash lite).
# DEJEVU_PRESET=cheap
# Or pick the model yourself. DEJEVU_PROVIDER pins an OpenRouter provider (fallbacks stay allowed).
# DEJEVU_MODEL=google/gemma-4-26b-a4b-it
# DEJEVU_PROVIDER=NextBit
# DEJEVU_LOGPROBS=1
# Characters of visible page text sent per step (default 4000). Lower it for very cheap endpoints.
# DEJEVU_TEXT_CHARS=4000

# Optional: use TypeSafe Jev as the chooser (the original jev-ultrafast design) plus a text helper for TYPE.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Browser. Leave unset to launch a private headless Chrome. Point at a running Chrome to reuse its logins.
# DEJEVU_CDP_URL=http://127.0.0.1:9222
# DEJEVU_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
